# Alpha is how fast gates open, beta is how fast gates close
def gate_rates(voltage):
    # Sodium activation (m), sodium inactivation (h),
    # potassium activation (n)
    alpha_m = (
        (0.1 * (voltage + 40))
        / (1 - np.exp(-(voltage + 40) / 10))
    )
    beta_m = 4 * np.exp(-(voltage + 65) / 18)

    alpha_h = 0.07 * np.exp(-(voltage + 65) / 20)
    beta_h = 1 / (1 + np.exp(-(voltage + 35) / 10))

    alpha_n = (
        (0.01 * (voltage + 55))
        / (1 - np.exp(-(voltage + 55) / 10))
    )
    beta_n = 0.125 * np.exp(-(voltage + 65) / 80)

    return alpha_m, beta_m, alpha_h, beta_h, alpha_n, beta_n


# Establish how many channels there are to determine max conductance
# We need max conductance to find current conductance
