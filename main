#injury_damage = #percent?

from neuron import simulate_neuron
import matplotlib.pyplot as plt

time, voltage, m, h, n = simulate_neuron()

fig, axes = plt.subplots(2, 1, figsize=(10, 8), sharex=True)

axes[0].plot(time, voltage, label='Membrane Potential (mV)', color='blue')
axes[0].set_ylabel('Membrane Potential (mV)')
axes[0].legend()

axes[1].plot(time, m, label='m (Sodium Activation)', color='orange')
axes[1].plot(time, h, label='h (Sodium Inactivation)', color='green')
axes[1].plot(time, n, label='n (Potassium Activation)', color='red')
axes[1].set_xlabel('Time (ms)')
axes[1].set_ylabel('Gating Variables')
axes[1].legend()

plt.tight_layout()
plt.savefig("neuron_plot.png", dpi=150)
print("Saved neuron_plot.png")
