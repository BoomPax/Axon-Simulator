def ionic_currents(voltage, m, h, n):
    # Calculate conductances based on gating variables
    g_na = na_g * (m ** 3) * h
    g_k = k_g * (n ** 4)
    g_l = l_g

    # Calculate currents based on conductances and reversal potentials
    i_na = g_na * (voltage - na_r)
    i_k = g_k * (voltage - k_r)
    i_l = g_l * (voltage - l_r)

    return i_na, i_k, i_l


# Estimate what state will be a moment later by calculating
# how fast something is changing right now
# New value = old value + rate of change * time interval (0.01ms)
def update_gates(voltage, m, h, n, dt):
    alpha_m, beta_m, alpha_h, beta_h, alpha_n, beta_n = gate_rates(voltage)

    dm_dt = alpha_m * (1 - m) - beta_m * m
    dh_dt = alpha_h * (1 - h) - beta_h * h
    dn_dt = alpha_n * (1 - n) - beta_n * n

    m += dm_dt * dt
    h += dh_dt * dt
    n += dn_dt * dt

    return m, h, n


